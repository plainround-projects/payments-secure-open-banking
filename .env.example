# Copied to .env by `make up` the first time (which also generates BANK_PEPPER). Every value is for a database and
# services that live on this machine only. Secrets of merchants and customers are NOT here: `make register` writes
# them under var/, which git ignores.
POSTGRES_HOST=localhost
POSTGRES_PORT=54613
POSTGRES_DB=openbanking
POSTGRES_USER=openbanking
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
DB_POOL_MAX_SIZE=20

# The bank. BANK_PEPPER keys the digests of one-time codes and bearer values (16 characters or more).
BANK_HOST=127.0.0.1
BANK_PORT=8463
BANK_PUBLIC_URL=http://127.0.0.1:8463
BANK_PEPPER=generated-by-make-up
BANK_SIGNING_KEY_FILE=var/bank-signing-key.pem
OTP_OUTBOX_FILE=var/otp-outbox.log
SCRYPT_N=16384
SHUTDOWN_GRACE_SECONDS=10
LOG_LEVEL=INFO

# Timing rules of the bank.
CHALLENGE_MINUTES=5
PROOF_MINUTES=2
TOKEN_MINUTES=10
CONSENT_MINUTES=10
RECURRING_CONSENT_DAYS=90
DPOP_MAX_SKEW_SECONDS=60
IDEMPOTENCY_KEY_TTL_HOURS=24

# The merchant (the demo reads its credentials from var/merchant-1.env, written by `make register`).
MERCHANT_HOST=127.0.0.1
MERCHANT_PORT=8464
BANK_URL=http://127.0.0.1:8463
MERCHANT_PAYEE_ACCOUNT=acct-shop
BANK_TIMEOUT_SECONDS=5
BANK_RETRY_ATTEMPTS=3
BANK_RETRY_BASE_DELAY_MS=50
